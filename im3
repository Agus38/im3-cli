DATE_FORMATS = ("%Y-%m-%d %H:%M:%S", "%Y-%m-%d", "%Y/%m/%d", "%d/%m/%Y",
                "%d-%m-%Y", "%d%m%Y", "%Y%m%d", "%d %b %Y", "%d %B %Y")


def parse_date(s):
    text = str(s or "").strip().replace("T", " ")
    text = text.split("+")[0].rstrip("Zz ").strip()
    if not text:
        return None
    for fmt in DATE_FORMATS:
        try:
            return datetime.datetime.strptime(text, fmt)
        except ValueError:
            continue
    digits = re.sub(r"\D", "", str(s or ""))
    if len(digits) == 8:
        for fmt in ("%Y%m%d", "%d%m%Y"):
            try:
                return datetime.datetime.strptime(digits, fmt)
            except ValueError:
                continue
    return None


def fmt_num(v):
    try:
        f = float(v)
    except (TypeError, ValueError):
        return str(v)
    return str(int(f)) if f == int(f) else f"{f:.1f}"


def gather_status(c):
    d = fetch(c, "/dashboard/get/v4", what="status", msg="Mengambil status nomor")
    info = d.get("prepaidinfo") or {}
    raw = info.get("balance") or (d.get("packdata") or {}).get("lastbalance") or "0"
    try:
        saldo = int(float(raw))
    except (TypeError, ValueError):
        saldo = 0
    packages = []
    for p in (d.get("packdata") or {}).get("packageslist") or []:
        name = str(p.get("ServiceDescription") or p.get("ServiceName") or "Paket")
        quotas = []
        for q in p.get("Quotas") or []:
            if q.get("show") != "ON":
                continue
            qname = str(q.get("name") or "Kuota")
            if str(q.get("unlimitedFlag")).lower() == "true":
                quotas.append({"name": qname, "pct": 100.0,
                               "text": ok("unlimited")})
                continue
            try:
                rem = float(q.get("remainingQuota"))
                init = float(q.get("initialQuota"))
            except (TypeError, ValueError):
                continue
            if not init:
                continue
            unit = str(q.get("quotaUnit") or "").strip()
            quotas.append({
                "name": qname,
                "pct": rem / init * 100.0,
                "text": f"{fmt_num(rem)}/{fmt_num(init)} {unit}".strip(),
            })
        packages.append({"name": name, "end": str(p.get("EndDate") or ""),
                         "quotas": quotas})
    return {"saldo": saldo, "msisdn": c.msisdn,
            "active_until": str(info.get("cardactiveuntil") or ""),
            "grace_until": str(info.get("graceperioduntil") or ""),
            "packages": packages}


def _days_left(when, now):
    d = parse_date(when)
    if not d:
        return None
    return (d.date() - now.date()).days


def evaluate_alerts(st, saldo_min=5000, kuota_min=10, hari=3, now=None):
    now = now or datetime.datetime.now()
    alerts = []
    if saldo_min and st["saldo"] < saldo_min:
        alerts.append({"key": f"saldo:{saldo_min}",
                       "text": f"saldo {rp(st['saldo'])} — di bawah batas {rp(saldo_min)}"})
    if kuota_min >= 0:
        for pkg in st["packages"]:
            for q in pkg["quotas"]:
                if q["pct"] <= kuota_min:
                    alerts.append({
                        "key": f"kuota:{pkg['name']}:{q['name']}",
                        "text": (f"{pkg['name']} · {q['name']} sisa {q['text']} "
                                 f"({q['pct']:.0f}%)"),
                    })
    if hari >= 0:
        for pkg in st["packages"]:
            left = _days_left(pkg["end"], now)
            if left is None or left > hari:
                continue
            when = "berakhir hari ini" if left == 0 else \
                ("sudah berakhir" if left < 0 else f"berakhir {left} hari lagi")
            alerts.append({"key": f"akhir:{pkg['name']}:{pkg['end']}",
                           "text": f"{pkg['name']} {when} ({pkg['end']})"})
        left = _days_left(st.get("active_until"), now)
        if left is not None and left <= hari:
            when = "berakhir hari ini" if left == 0 else \
                ("sudah berakhir" if left < 0 else f"berakhir {left} hari lagi")
            alerts.append({"key": f"masaaktif:{st.get('active_until')}",
                           "text": f"masa aktif {when} ({st.get('active_until')})"})
    return alerts


