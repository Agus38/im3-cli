def cmd_watch(c, opts):
    failures = 0
    try:
        while True:
            try:
                st = gather_status(c)
                failures = 0
            except SystemExit:
                failures += 1
                if not opts.loop or failures >= 3:
                    raise
                print(err_msg(f"gagal mengambil status ({failures}/3)"))
                time.sleep(max(30, opts.interval))
                continue
            alerts = evaluate_alerts(st, opts.saldo_min, opts.kuota_min, opts.hari)
            print_watch(st, alerts)
            sent = dispatch_alerts(alerts, st, opts.cooldown, opts.force)
            if sent:
                res = send_telegram(watch_alert_message(st, sent))
                if res is True:
                    print(ok_msg(f"notifikasi terkirim ({len(sent)} peringatan)"))
                elif res is False:
                    print(warn_msg("Telegram gagal mengirim notifikasi"))
                else:
                    print(hint("notifikasi Telegram belum aktif — "
                              "im3 watch --setup-telegram <token> <chat_id>"))
                print()
            if not opts.loop:
                sys.exit(2 if alerts else 0)
            print(hint(f"cek berikutnya dalam {opts.interval}s"))
            time.sleep(max(10, opts.interval))
    except KeyboardInterrupt:
        print()
        print(ok_msg("watch dihentikan"))


