def send_telegram(text):
    tg = load_config().get("telegram") or {}
    token, chat = tg.get("token"), tg.get("chat_id")
    if not token or not chat:
        return None
    try:
        r = requests.post(f"https://api.telegram.org/bot{token}/sendMessage",
                          json={"chat_id": str(chat), "text": text},
                          timeout=20)
        return bool(r.json().get("ok"))
    except (requests.RequestException, ValueError):
        return False


def watch_alert_message(st, sent):
    lines = [f"im3 CLI v{VERSION} · {fmt_msisdn(st.get('msisdn'))}"]
    lines += ["- " + RE_ANSI.sub("", a["text"]) for a in sent]
    return "\n".join(lines)


def dispatch_alerts(alerts, st, cooldown, force):
    """Record alert timestamps, return the ones due for notification."""
    p = state_path("watch-state.json")
    try:
        with open(p) as f:
            prev = (json.load(f).get("alerts") or {})
    except (OSError, ValueError):
        prev = {}
    now = datetime.datetime.now()
    sent = []
    for a in alerts:
        last = prev.get(a["key"])
        fresh = True
        if last and not force:
            try:
                fresh = (now - datetime.datetime.fromisoformat(last)).total_seconds() >= cooldown
            except ValueError:
                fresh = True
        if fresh:
            sent.append(a)
    sent_keys = {a["key"] for a in sent}
    state = {}
    for a in alerts:
        state[a["key"]] = now.isoformat(timespec="seconds") \
            if a["key"] in sent_keys else prev.get(a["key"],
                                                   now.isoformat(timespec="seconds"))
    with open(p, "w") as f:
        json.dump({"alerts": state}, f)
    os.chmod(p, 0o600)
    return sent


