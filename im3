    amt = rp(amt) if amt != "-" and str(amt).lstrip("-").isdigit() else amt
    rows = [("Waktu", _first(t, TX_DATE)),
            ("Keterangan", _first(t, TX_DESC)),
            ("Jumlah", accent(bold(amt))),
            ("Status", _status_style(_first(t, TX_STAT))),
            ("Transid", dim(transid))]
    print()
    print(card("STRUK", rows=rows, right="Pembelian", right_style=info))


def audit_purchase(entry):
    p = state_path("purchases.jsonl")
    with open(p, "a") as f:
        f.write(json.dumps(entry, ensure_ascii=False) + "\n")
    os.chmod(p, 0o600)


def run_buy(c, pkg, yes=False, dry_run=False):
    pvr = str(pkg.get("pvr_code") or "").strip()
    if not pvr:
        die("paket ini tidak punya kode pvr_code — tidak bisa dibeli")
    if str(pkg.get("buy_flag") or "Y").upper() == "N":
        die("paket ini tidak bisa dibeli dari app (buy_flag != Y)")
    price = price_int(pkg)
    if not price:
        die("harga paket tidak diketahui — batal")
    channels = pay_channels(c)
    if not channels:
        die("tidak ada kanal pembayaran yang tersedia")
    channel = next((ch for ch in channels
                    if str(ch.get("channelid")).upper() == "BALANCE"), channels[0])
    saldo = fetch_balance(c)
    show_quote(c, pkg, channels, saldo, price)

    elig = check_eligible(c, pkg, channel)
    state = str(elig.get("eligibility") or "").upper()
    if state == "ELIGIBLE":
        print(f"   {ok('✓')} nomor memenuhi syarat untuk paket ini")
    else:
        reason = (elig.get("responsemsg") or elig.get("ineligiblereason")
                  or elig.get("errordesc") or "tidak memenuhi syarat")
        die(f"nomor tidak memenuhi syarat: {reason}")

    if dry_run:
        print()
        print(hint("dry-run — tidak ada pembayaran. ulangi dengan --pay untuk beli"))
        return

    print()
    if not confirm_buy(price, yes):
        return

    transid = pay(c, pkg, channel)
    print(f"   {ok('✓')} permintaan terkirim  transid {dim(transid)}")
    status, _ = poll_payment(c, transid)
    entry = {"time": datetime.datetime.now().isoformat(timespec="seconds"),
             "msisdn": c.msisdn, "pvr_code": pvr, "package": pkg_name(pkg),
             "price": price, "channel": str(channel.get("channelid") or ""),
             "transid": transid, "status": status}
    audit_purchase(entry)

    if status == "SUCCESS":
        print(ok_msg(f"pembelian berhasil — {pkg_name(pkg)} {rp(price)}"))
    elif status == "FAILED":
        print(err_msg("pembelian gagal"))
    else:
        print(warn_msg(f"status {status} — pantau di menu 4 (Riwayat transaksi)"))
    rcpt = receipt(c, transid)
    if rcpt:
        show_receipt(rcpt, transid)
    print(hint(f"catatan pembelian: {dim(state_path('purchases.jsonl'))}"))


