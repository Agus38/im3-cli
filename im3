def show_package_detail(p):
    ca = p.get("commercial_attribute") or {}
    rows = []

    def add(label, value, style=None):
        if value in (None, "", "null", "None", "-"):
            return
        value = str(value)
        rows.append((label, style(value) if style else value))

    if p.get("original_tariff") and str(p.get("original_tariff")) != str(p.get("tariff")):
        add("Harga normal", p["original_tariff"], rp)
    add("Masa aktif", pkg_validity(p))
    add("Manfaat", ca.get("short_benefit"), accent)
    add("Kuota", ca.get("family_name"))
    add("Deskripsi", p.get("package_subtitle"))
    add("Info", p.get("package_footer_desc"))
    add("Bisa dibeli", "ya" if str(p.get("buy_flag")).upper() == "Y" else "tidak")
    add("Tipe", p.get("offertype"))
    add("Kode", p.get("pvr_code"), dim)
    add("Keyword", p.get("keyword"), violet)
    print(card("DETAIL PAKET", rows=rows, right=price_text(p),
               right_style=lambda t: accent(bold(t))))


