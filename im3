          "trxamount")
TX_STAT = ("status", "txstatus", "transactionstatus", "trxstatus")


def _first(item, keys):
    for k in keys:
        v = item.get(k)
        if v not in (None, "", "null", "None"):
            return str(v)
    return "-"


def _status_style(s):
    low = s.lower()
    if any(k in low for k in ("success", "berhasil", "complete", "paid", "ok")):
        return ok(s)
    if any(k in low for k in ("pending", "proses", "menunggu")):
        return warn(s)
    if any(k in low for k in ("fail", "gagal", "error", "cancel", "batal")):
        return err(s)
    return s


