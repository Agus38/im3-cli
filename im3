def fetch_package(c, pvr):
    data = fetch(c, "/packages/getpackage", what="detail paket",
                 body={"servicename": "GET PACKAGE", "PVR_CODE": pvr,
                       "cvmtype": 0},
                 msg="Memuat detail paket")
    pkg = data.get("commercial_package")
    if not pkg:
        die(f"paket {pvr} tidak ditemukan")
    return pkg


def fetch_balance(c):
    d = fetch(c, "/dashboard/get/v4", what="saldo", msg="Mengambil saldo")
    val = ((d.get("prepaidinfo") or {}).get("balance")
           or (d.get("packdata") or {}).get("lastbalance") or "0")
    try:
        return int(float(val))
    except (TypeError, ValueError):
        return 0


def pay_channels(c):
    data = fetch(c, "/payment/checkavailability", what="kanal bayar",
                 body={"paymentchannels": "", "transtype": "package",
                       "operationtype": "buy"},
                 msg="Mengecek kanal pembayaran")
    return data.get("sofAvailability") or []


def transtype_of(pkg):
    t = str(pkg.get("offertype") or "").lower()
    if t == "cvm":
        return "cvm"
    if t == "content":
        return "content"
    return "package"


def is_vas(pkg):
    return (str(pkg.get("offertype") or "").lower() == "content"
            or str(pkg.get("package_type") or "") == "5")


def pay_endpoint(pkg, channel):
    channelid = str(channel.get("channelid") or "").upper()
    if channelid == "BALANCE":
        if str(pkg.get("offertype") or "").lower() == "cvm":
            return "/offer/handleintent"
        return "/vaspackages/activate" if is_vas(pkg) else "/packages/activate"
    if str(channel.get("paymentgw") or "").upper() == "ESB":
        return "/esb/initiatepayment"
    return "/payment/payment"


def discount_price(pkg):
    try:
        original = float(pkg.get("original_tariff"))
        tariff = float(pkg.get("tariff"))
    except (TypeError, ValueError):
        return "0"
    return str(int(original - tariff)) if original != tariff else "0"


def show_quote(c, pkg, channels, saldo, price):
    after = saldo - price
    names = ", ".join(str(ch.get("name") or ch.get("channelid") or "")
                      for ch in channels) or "-"
    rows = [("Paket", bold(pkg_name(pkg))),
            ("Harga", accent(bold(rp(price)))),
            ("Saldo", rp(saldo)),
            ("Sisa", (rp(after) if after >= 0 else err(f"kurang {rp(-after)}"))),
            ("Metode", info(names)),
            ("Kode", violet(str(pkg.get("pvr_code") or "-")))]
    if pkg.get("keyword"):
        rows.append(("Keyword", violet(str(pkg["keyword"]))))
    print(card("QUOTE PEMBELIAN", rows=rows, right=fmt_msisdn(c.msisdn),
               right_style=accent))
    if after < 0:
        print(warn_msg(f"saldo kurang {rp(-after)} — transaksi bisa ditolak server"))


def confirm_buy(price, yes=False):
    if yes:
        return True
    if not sys.stdin.isatty():
        die("mode non-interaktif: tambahkan --yes untuk konfirmasi pembelian")
    expect = f"BELI {price}"
    print()
    ans = prompt(f"ketik {accent(bold(expect))} untuk konfirmasi  (b = batal)")
    if ans == expect:
        return True
    if ans.strip().lower() in ("", "b", "batal", "n", "no", "q", "quit"):
        print(err_msg("konfirmasi dibatalkan"))
        return False
    print(err_msg(f"tidak cocok — diharapkan {expect}"))
    return False


def check_eligible(c, pkg, channel):
    body = {
        "transtype": transtype_of(pkg),
        "operationtype": "buy",
        "paymentchannel": str(channel.get("channelid") or ""),
        "offerid": str(pkg.get("pvr_code") or ""),
        "transid": "",
        "tomsisdn": "62" + (c.msisdn or ""),
        "normalprice": str(pkg.get("original_tariff") or ""),
        "packagename": str(pkg.get("package_name") or ""),
        "name": "",
        "keyword": str(pkg.get("keyword") or ""),
        "shortcode": str(pkg.get("shortcode") or ""),
    }
    with Loader("Mengecek kelayakan pembelian"):
        resp = c.post("/packages/checkeligible", body)
    check(resp, "cek kelayakan")
    return resp.get("data") or {}


def pay(c, pkg, channel):
    body = {
        "transtype": transtype_of(pkg),
        "operationtype": "buy",
        "paymentchannel": str(channel.get("channelid") or ""),
        "offerid": str(pkg.get("pvr_code") or ""),
        "keyword": str(pkg.get("keyword") or ""),
        "shortcode": str(pkg.get("shortcode") or ""),
        "tomsisdn": "62" + (c.msisdn or ""),
        "normalprice": str(pkg.get("original_tariff") or ""),
        "discountprice": discount_price(pkg),
        "packagename": str(pkg.get("package_name") or ""),
        "name": "",
        "transid": "",
        "walletmsisdn": "",
        "type": str(channel.get("groupid") or ""),
    }
    if pkg.get("cvmtype") not in (None, "", 0, 0.0):
        body["cvmtype"] = str(pkg["cvmtype"])
    path = pay_endpoint(pkg, channel)
    with Loader(f"Mengirim permintaan pembayaran {dim(path)}"):
        resp = c.post(path, body)
    check(resp, "pembayaran")
    data = resp.get("data") if isinstance(resp.get("data"), dict) else {}
    transid = str(resp.get("transid") or data.get("transid") or "")
    if not transid:
        die(f"transid tidak ada di response: {json.dumps(resp)[:300]}")
    return transid


def poll_payment(c, transid, tries=8, interval=3.0):
    status, detail = "PENDING", {}
    for i in range(tries):
        with Loader(f"Menunggu konfirmasi  ({i + 1}/{tries})"):
            resp = c.post("/payment/chkstatus/v2", {"paymenttid": transid})
        if resp.get("status") == "0":
            detail = (resp.get("data") or {}).get("checkStatusResp") or {}
            status = str(detail.get("statusTransaction") or "PENDING").upper()
            if status in ("SUCCESS", "FAILED"):
                return status, detail
        if i < tries - 1:
            time.sleep(interval)
    return status, detail


def receipt(c, transid):
    with Loader("Mengambil struk"):
        resp = c.post("/transaction/getbyid", {"transid": transid})
    if resp.get("status") != "0":
        return None
    tx = (resp.get("data") or {}).get("transactions") or []
    return tx[0] if tx else None


def show_receipt(t, transid):
