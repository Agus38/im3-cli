IND = "   "
_COLOR = sys.stdout.isatty() and "NO_COLOR" not in os.environ
RE_ANSI = re.compile(r"\033\[[0-9;]*m")


def paint(code, text):
    return f"\033[{code}m{text}\033[0m" if _COLOR else text


def bold(t):
    return paint("1", t)


def dim(t):
    return paint("2", t)


def _p256(n, text):
    return f"\033[38;5;{n}m{text}\033[0m" if _COLOR else text


def accent(t):
    return _p256(208, t)


def info(t):
    return _p256(44, t)


def ok(t):
    return _p256(40, t)


def warn(t):
    return _p256(214, t)


def err(t):
    return _p256(203, t)


def muted(t):
    return _p256(243, t)


def violet(t):
    return _p256(141, t)


def ok_msg(text):
    return f"{IND}{ok('✓')} {text}"


def err_msg(text):
    return f"{IND}{err('✗')} {text}"


def warn_msg(text):
    return f"{IND}{warn('!')} {text}"


def hint(text):
    return f"{IND}{dim(text)}"


def vis_len(text):
    return len(RE_ANSI.sub("", text))


def truncate(text, width):
    if vis_len(text) <= width:
        return text
    plain = RE_ANSI.sub("", text)
    if width <= 1:
        return plain[:width]
    return plain[:width - 1] + "…"


def pad(text, width, align="<"):
    gap = width - vis_len(text)
    if gap <= 0:
        return text
    if align == ">":
        return " " * gap + text
    if align == "^":
        left = gap // 2
        return " " * left + text + " " * (gap - left)
    return text + " " * gap


def term_width():
    try:
        w = shutil.get_terminal_size((80, 24)).columns
    except OSError:
        w = 0
    return w if w >= 40 else 80


def box_width():
    return max(36, min(78, term_width() - 4))


MIN_W = 44


def header(title, right="", right_style=info, width=None):
    w = width or box_width()
    inner = w - 2
    left = f"─ {title} ─"
    tail_plain = f"─ {right}─" if right else ""
    fill = inner - len(left) - len(tail_plain)
    if fill < 1:
        right, tail_plain = "", ""
        fill = inner - len(left)
        if fill < 1:
            left, fill = "─…─", inner - 4
    tail = muted("─ ") + right_style(right) + muted("─") if right else ""
    return (f"{IND}{muted('╭')}" + accent(bold(left)) + muted("─" * fill)
            + tail + muted("╮"))


def card(title, rows=(), right="", right_style=info):
    labels = [len(str(l)) for l, _ in rows if l]
    lw = min(max(labels + [8]), 24)
    needed = 0
    for label, value in rows:
        value = "" if value is None else str(value)
        if label:
            needed = max(needed, lw + 2 + vis_len(value))
        else:
            needed = max(needed, vis_len(value))
    left = f"─ {title} ─"
    tail = f"─ {right}─" if right else ""
    w = max(min(needed + 4, box_width()), min(MIN_W, box_width()),
            len(left) + len(tail) + 3)
    body = w - 4
    lw = min(lw, max(6, body - 10))
    lines = [header(title, right=right, right_style=right_style, width=w)]
    for label, value in rows:
        if not label:
            content = truncate(str(value), body)
            lines.append(f"{IND}{muted('│')} {content}"
                         f"{' ' * max(0, body - vis_len(content))} {muted('│')}")
            continue
        value = "" if value is None else str(value)
        lbl = muted(truncate(str(label), lw))
        val = truncate(value, max(0, body - lw - 2))
        content = f"{pad(lbl, lw)}  {val}"
        lines.append(f"{IND}{muted('│')} {content}"
                     f"{' ' * max(0, body - vis_len(content))} {muted('│')}")
    lines.append(f"{IND}{muted('╰' + '─' * (w - 2) + '╯')}")
    return "\n".join(lines)


def _table_widths(headers, rows):
    ncol = len(headers)
    widths = [len(str(h)) for h in headers]
    for row in rows:
        for i, cell in enumerate(row):
            widths[i] = max(widths[i], vis_len(str(cell)))
    budget = box_width() - (ncol + 1) - 2 * ncol
    while sum(widths) > budget:
        cand = [i for i in range(ncol) if widths[i] > 6]
        if not cand:
            break
        widths[max(cand, key=lambda k: widths[k])] -= 1
    natural = sum(widths) + 3 * ncol + 1
    pad_w = min(MIN_W, box_width())
    if natural < pad_w:
        widths[-1] += pad_w - natural
    return widths


def render_table(headers, rows, align=None, styles=None, widths=None):
    ncol = len(headers)
    align = list(align or ["<"] * ncol)
    styles = list(styles or [None] * ncol)
    widths = list(widths or _table_widths(headers, rows))

    def line(cells, head=False):
        parts = []
        for i, cell in enumerate(cells):
            txt = pad(truncate(str(cell), widths[i]), widths[i], align[i])
            if head:
                txt = accent(bold(txt))
            elif styles[i]:
                txt = styles[i](txt)
            parts.append(f" {txt} ")
        return f"{IND}{muted('│')}{muted('│').join(parts)}{muted('│')}"

    seg = "┬".join("─" * (w + 2) for w in widths)
    mid = "┼".join("─" * (w + 2) for w in widths)
    bot = "┴".join("─" * (w + 2) for w in widths)
    out = [f"{IND}{muted('╭' + seg + '╮')}",
           line(headers, head=True),
           f"{IND}{muted('├' + mid + '┤')}"]
    out += [line(r) for r in rows]
    out.append(f"{IND}{muted('╰' + bot + '╯')}")
    return "\n".join(out)


def print_table(title, headers, rows, right="", align=None, styles=None,
                right_style=info):
    widths = _table_widths(headers, rows)
    width = sum(w + 2 for w in widths) + len(headers) + 1
    if title:
        print(header(title, right=right, right_style=right_style, width=width))
    print(render_table(headers, rows, align=align, styles=styles,
                       widths=widths))


