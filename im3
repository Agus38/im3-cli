BULAN = ["Jan", "Feb", "Mar", "Apr", "Mei", "Jun",
         "Jul", "Agu", "Sep", "Okt", "Nov", "Des"]


def fmt_dt(s):
    m = re.match(r"^(\d{4})(\d{2})(\d{2})(\d{2})(\d{2})", str(s or ""))
    if not m:
        return str(s or "-")
    y, mo, d, hh, mm = m.groups()
    return f"{int(d)} {BULAN[int(mo) - 1]} {y} {hh}:{mm}"


def fmt_month(ym):
    m = re.match(r"^(\d{4})(\d{2})$", str(ym or ""))
    if not m:
        return str(ym or "-")
    return f"{BULAN[int(m.group(2)) - 1]} {m.group(1)}"


def _unit(v):
    if not isinstance(v, dict) or v.get("value") is None:
        return "-"
    return f"{v.get('value')} {v.get('unit', '')}".strip()


def cmd_userdata(c):
    d = fetch(c, "/usages/history", what="pemakaian",
              msg="Mengambil riwayat pemakaian")
    summary = d.get("summary") or {}
    rows = [(k, _unit(summary.get(key)))
            for k, key in (("Data", "data"), ("Nelpon", "voice"), ("SMS", "sms"))
            if isinstance(summary.get(key), dict)]
    if d.get("queryUsageConsumptionDate"):
        rows.append(("Sampai", fmt_dt(d["queryUsageConsumptionDate"])))
    print(card("PEMAKAIAN", rows=rows or [(None, "belum ada data pemakaian")]))
    print()

    def per_month(key):
        return {str(x.get("month")): x for x in (d.get(key) or [])
                if isinstance(x, dict)}

    md, mv, ms = per_month("data"), per_month("voice"), per_month("sms")
    months = sorted(set(md) | set(mv) | set(ms), reverse=True)
    if months:
        brows = [[fmt_month(m), _unit(md.get(m)), _unit(mv.get(m)),
                  _unit(ms.get(m))] for m in months]
        print_table("PEMAKAIAN BULANAN", ["Bulan", "Data", "Nelpon", "SMS"], brows,
                    right=f"{len(months)} bulan",
                    align=["<", ">", ">", ">"],
                    styles=[muted, accent, None, None])
