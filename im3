# --------------------------------------------------------------------------- crypto


def rc4(data: str) -> str:
    s = list(range(256))
    k = [RC4_KEY[i % len(RC4_KEY)] for i in range(256)]
    j = 0
    for i in range(256):
        j = (j + s[i] + k[i]) % 256
        s[i], s[j] = s[j], s[i]
    out = bytearray()
    i = j = 0
    for ch in data.encode("latin-1"):
        i = (i + 1) % 256
        j = (j + s[i]) % 256
        s[i], s[j] = s[j], s[i]
        out.append(ch ^ s[(s[i] + s[j]) % 256])
    return out.hex()


def odd_chars(s: str) -> str:
    return "".join(s[i] for i in range(0, len(s), 2))


def sha512(payload: str) -> str:
    return hashlib.sha512(payload.encode()).hexdigest()


# --------------------------------------------------------------------------- utils


def normalize_msisdn(raw: str) -> str:
    """Return national format without country code, e.g. 62812... -> 812..."""
    n = "".join(c for c in raw if c.isdigit())
    if n.startswith("0"):
        n = n[1:]
    elif n.startswith("62"):
        n = n[2:]
    return n


def die(msg, code=1):
    print(f"   {err('✗')} {msg}", file=sys.stderr)
    sys.exit(code)


class Loader:
    """Spinner shown while a network request is in flight."""

    FRAMES = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"

    def __init__(self, msg="Memuat"):
        self.msg = msg
        self._done = threading.Event()
        self._thread = None

    def _spin(self):
        i = 0
        start = time.time()
        clear = 0
        while not self._done.is_set():
            frame = self.FRAMES[i % len(self.FRAMES)]
            secs = int(time.time() - start)
            plain = f"{frame} {self.msg}" + (f" ({secs}s)" if secs else "")
            colored = accent(f"{frame} {self.msg}") + dim(f" ({secs}s)") if secs \
                else accent(plain)
            if clear:
                sys.stdout.write("\r" + " " * clear + "\r")
            sys.stdout.write(f"   {colored}")
            sys.stdout.flush()
            clear = len(plain) + 3
            i += 1
            self._done.wait(0.1)
        if clear:
            sys.stdout.write("\r" + " " * clear + "\r")
            sys.stdout.flush()

    def __enter__(self):
        if sys.stdout.isatty():
            self._thread = threading.Thread(target=self._spin, daemon=True)
            self._thread.start()
        else:
            print(f"   {self.msg}...")
        return self

    def __exit__(self, *exc):
        if self._thread:
            self._done.set()
            self._thread.join()
        return False


class Im3Client:
    def __init__(self, msisdn=None, token=None, device=None):
        # msisdn = national format without country code, e.g. 81234567890.
        # The API expects the body msisdn with the 62 prefix (getValidMobileNumber
        # in the PWA prepends COUNTRYCODE), while X-IMI-UID uses the local format.
        self.msisdn = msisdn
        self.msisdn_full = "62" + msisdn if msisdn else None
        self.device = device or uuid.uuid4().hex
        self.token = token
        self.tid = None
        if not self.token:
            self.token, self.tid = self._guest_token()

    def _guest_token(self):
        tid = str(int(time.time() * 1000))
        params = {
            "X-IMI-TOKENID": "",
            "X-IMI-CHANNEL": rc4(CHANNEL),
            "X-IMI-LANGUAGE": rc4("ID"),
            "tid": rc4(tid),
            "X-IMI-App-OS": rc4("BROWSER"),
            "pf": PROJECT,
            "X-DEVICEID": rc4(self.device),
        }
        with Loader("Menghubungkan ke server"):
            r = requests.get(HE_URL, params=params, headers={
                "Origin": "https://myim3app.indosatooredoo.com",
                "Referer": "https://myim3app.indosatooredoo.com/",
                "User-Agent": UA,
            }, timeout=30, allow_redirects=False)
        loc = r.headers.get("location", "")
        if "#/he/" not in loc:
            raise RuntimeError(f"guest token failed: HTTP {r.status_code} {r.text[:200]}")
        frag = loc.split("#/he/")[-1]
        raw = base64.b64decode(frag + "=" * (-len(frag) % 4)).decode("utf-8", "replace")
        session_id, jwt = raw.split("|")[:2]
        return jwt, session_id

    def _headers(self, body=None):
        # The PWA's HTTP interceptor builds a per-request nonce and uses it as
        # X-IMI-UID; X-IMI-HASH is salted with that nonce (not the token).
        now = datetime.datetime.now()
        nonce = now.strftime("%Y%m%d%H%M%S") + f"{now.microsecond // 1000:03d}" \
            + str(random.randint(100, 999))
        h = {
            "Authorization": HDR_AUTH,
            "Content-Type": "application/json",
            "Accept": "application/json",
            "X-IMI-App-OS": "BROWSER",
            "X-IMI-APPVERSION": APP_VERSION,
            "X-IMI-CHANNEL": CHANNEL,
            "X-IMI-LANGUAGE": "ID",
            "X-IMI-VERSION": APP_VERSION,
            "X-IMI-SERVICEKEY": SERVICE_KEY,
            "X-DEVICEID": self.device,
            "X-DEVICENAME": "Chrome",
            "X-IMI-TOKENID": self.token,
            "X-IMI-UID": nonce,
            "X-IMI-CHILD-LINENO": "",
            "X-FAIID": "",
            "Origin": "https://myim3app.indosatooredoo.com",
            "Referer": "https://myim3app.indosatooredoo.com/",
            "User-Agent": UA,
        }
        if body is not None:
            raw = json.dumps(body, separators=(",", ":"))
            h["x-imi-oauth"] = sha512(
                f"REQBODY={raw}&SALT={odd_chars(self.token)}")
        base = f"parent$BROWSER${APP_VERSION}${self.token}"
        h["X-IMI-HASH"] = sha512(f"{base}&SALT={odd_chars(nonce)}")
        return h

    def post(self, path, body=None, retry=2):
        body = body or {}
        raw = json.dumps(body, separators=(",", ":"))
        for attempt in range(retry + 1):
            try:
                r = requests.post(BASE + path, data=raw,
                                  headers=self._headers(body), timeout=45)
                break
            except requests.RequestException as e:
                if attempt < retry:
                    time.sleep(1.0)
                    continue
                die(f"network error: {e}")
        if os.environ.get("IM3_DEBUG"):
            print(f"[debug] POST {path} -> HTTP {r.status_code} {r.text[:400]}",
                  file=sys.stderr)
        try:
            return r.json()
        except ValueError:
            return {"status": "1", "message": f"HTTP {r.status_code}: {r.text[:300]}"}

    def get(self, path):
        try:
            r = requests.get(BASE + path, headers=self._headers(None), timeout=45)
            return r.json()
        except (requests.RequestException, ValueError) as e:
            return {"status": "1", "message": str(e)}


def check(resp, what="request"):
    if resp.get("status") != "0":
        hint = ""
        if resp.get("code") == "10005":
            hint = ("\nhint: pastikan nomor aktif IM3 (prefix 0815/0816/0856/0857/0858), "
                    "dan tulis tanpa '+' atau spasi.")
        elif resp.get("code") == "10013":
            hint = ("\nhint: OTP salah atau sudah kedaluwarsa (TTL 5 menit). "
                    "Jalankan ulang `im3 login` untuk meminta OTP baru.")
        elif resp.get("code") == "10012":
            hint = ("\nhint: server menolak signature/header request. "
                    "Biasanya karena versi app PWA berubah; cek APP_VERSION di script.")
        elif resp.get("code") == "10021":
            hint = ("\nhint: server minta jeda singkat (rate limit). "
                    "Tunggu sebentar lalu jalankan ulang perintah.")
        elif resp.get("code") == "90119":
            hint = ("\nhint: layanan pembayaran sedang dalam pemeliharaan.")
        elif resp.get("code") == "20188":
            hint = "\nhint: belum ada paket pada kategori/parameter yang dipilih."
        die(f"{what} failed [{resp.get('code')}]: {resp.get('message')}{hint}")
    return resp


