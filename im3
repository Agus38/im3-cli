def fetch(c, path, what="data", body=None, msg=None, tries=3):
    """Call an endpoint through the spinner, retrying server throttling (10021)."""
    resp = None
    for attempt in range(tries):
        with Loader(msg or f"Memuat {what}"):
            resp = c.post(path, body)
        if resp.get("code") == "10021" and attempt < tries - 1:
            time.sleep(1.5 * (attempt + 1))
            continue
        break
    return check(resp, what).get("data", {})


def rp(value):
    try:
        return "Rp" + f"{int(value):,}".replace(",", ".")
    except (TypeError, ValueError):
        return str(value)


def price_text(p):
    if p.get("tariff_display"):
        digits = re.sub(r"\D", "", str(p["tariff_display"]))
        if digits:
            return rp(digits)
        return str(p["tariff_display"])
    if p.get("tariff") not in (None, ""):
        return rp(p["tariff"])
    return "-"


def price_int(p):
    try:
        if p.get("tariff") not in (None, ""):
            return int(float(p["tariff"]))
    except (TypeError, ValueError):
        pass
    digits = re.sub(r"\D", "", str(p.get("tariff_display") or ""))
    return int(digits) if digits else 0


def pkg_name(p):
    return (p.get("package_name") or p.get("short_benefit")
            or p.get("myim3_product_cd") or p.get("keyword") or "-")


def pkg_validity(p):
    ca = p.get("commercial_attribute") or {}
    return (ca.get("duration_month") or p.get("validity")
            or ca.get("validity_type") or "-")


def extract_packages(data):
    if not isinstance(data, dict):
        return []
    for key in ("commercial_package", "packages", "packageslist",
                "package_list", "list"):
        val = data.get(key)
        if isinstance(val, list) and val:
            return val
    for val in data.values():
        if isinstance(val, list) and val and isinstance(val[0], dict):
            return val
    return []


def flatten_categories(data):
    leaves = []
    for cat in data if isinstance(data, list) else []:
        group = cat.get("title") or cat.get("description") or "-"
        subs = cat.get("categories") or []
        if subs:
            for sub in subs:
                leaves.append({
                    "group": group,
                    "title": sub.get("title") or sub.get("description") or "-",
                    "catid": str(sub.get("categoryid")),
                    "apiurl": sub.get("apiurl"),
                })
        else:
            leaves.append({
                "group": group,
                "title": group,
                "catid": str(cat.get("categoryid")),
                "apiurl": cat.get("apiurl"),
            })
    return leaves


def load_categories(c):
    data = fetch(c, "/packages/getpackagecategory/v2", what="kategori",
                 msg="Memuat kategori paket")
    return flatten_categories(data)


def search_groups(c, term):
    data = fetch(c, "/packages/search", what="hasil pencarian",
                 body={"SEARCH_TERM": term, "servicename": "GET PACKAGE"},
                 msg=f"Mencari {dim(term)}")
    groups = []
    for cat in data.get("commercial_package_category") or []:
        items = cat.get("commercial_package") or []
        if items:
            groups.append((str(cat.get("category_name") or "Lainnya"), items))
    return groups


def flatten_groups(groups):
    return [p for _, items in groups for p in items]


def search_table(groups, term):
    rows, flat = [], []
    for gname, items in groups:
        for p in items:
            flat.append(p)
            rows.append([str(len(flat)), pkg_name(p), price_text(p),
                         pkg_validity(p), gname])
    print_table(f"HASIL CARI · {term}",
                ["No", "Paket", "Harga", "Masa Aktif", "Grup"],
                rows, right=f"{len(rows)} produk",
                align=["^", "<", ">", "<", "<"],
                styles=[muted, None, accent, dim, muted])
    return flat


