    if not os.path.exists(p):
        return None
    with open(p) as f:
        return json.load(f)


def do_login(msisdn_arg=None):
    try:
        raw = msisdn_arg or input(f"   Nomor IM3 (mis. 81234567890) {accent('▸')} ")
    except (EOFError, KeyboardInterrupt):
        print()
        die("input berakhir — butuh nomor IM3")
    msisdn = normalize_msisdn(raw)
    if len(msisdn) < 9 or not msisdn.startswith("8"):
        die("nomor tidak valid (harus diawali 8, panjang 9-12 digit)")

    c = Im3Client(msisdn=msisdn)
    with Loader(f"Mengirim OTP ke +62{msisdn}"):
        resp = c.post("/otp/send/v1", {"msisdn": c.msisdn_full, "action": "register"})
    resp = check(resp, "kirim OTP")
    print(f"   {ok('✓')} OTP terkirim ke {accent('+62' + msisdn)}")
    candidates = []
    for t in (resp.get("data", {}).get("transid"), resp.get("transid")):
        if t and t not in candidates:
            candidates.append(t)
    if not candidates:
        die(f"transid tidak ada di response: {json.dumps(resp)[:300]}")
    for _ in range(3):
        try:
            otp = input(f"   Masukkan OTP (6 digit) {accent('▸')} ").strip().replace(" ", "")
        except (EOFError, KeyboardInterrupt):
            print()
            die("input berakhir — butuh kode OTP")
        if otp.isdigit() and len(otp) == 6:
            break
        print(f"   {warn('!')} OTP harus 6 digit angka.")
    else:
        die("OTP tidak valid")

    resp = None
    for transid in candidates:
        with Loader("Memverifikasi OTP"):
            resp = c.post("/otp/validate/v1", {"transid": transid, "otp": otp})
        if resp.get("status") == "0":
            break
        print(f"   {warn('!')} transid {dim(transid[:8])}... ditolak "
              f"[{resp.get('code')}] — mencoba transid lain")
    check(resp, "verifikasi OTP")
    data = resp.get("data", {})
    token = data.get("token") or data.get("tokenid")
    if not token:
        die(f"token tidak ada di response: {json.dumps(data)[:300]}")
    save_session(msisdn, token, c.device)
    print(f"   {ok('✓')} Login berhasil — sesi tersimpan di {dim(state_path('session.json'))}")
    if str(data.get("newuser")).lower() == "true":
        print(f"   {warn('!')} akun ini belum melengkapi profil di app myIM3.")
    return c


